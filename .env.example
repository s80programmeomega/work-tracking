APP_NAME=Work-Tracking
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# URL du frontend SPA — doit correspondre exactement à l'URL que l'utilisateur tape dans son navigateur.
# Utilisée dans les liens des emails de notification pour éviter les problèmes d'origine (127.0.0.1 vs localhost).
APP_FRONTEND_URL=http://localhost:8000

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=work-tracking
DB_USERNAME=root
DB_PASSWORD=jonas

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — défaut "log" pour le dev local sans dépendance SMTP.
# Les emails atterrissent dans storage/logs/laravel.log. Pour activer
# un vrai envoi:
#   - Docker dev w/ mailpit container: MAIL_MAILER=smtp, MAIL_HOST=mailpit
#   - Local dev w/ mailpit on host:    MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1
#   - Production:                      MAIL_MAILER=smtp + creds réels
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Web Push (Task 8b) — clés VAPID
# Générer avec : php artisan webpush:generate-vapid
# La clé privée doit rester confidentielle ; la clé publique est exposée au frontend.
VAPID_SUBJECT=mailto:teams@cerdafrica.org
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEBPUSH_TTL=14400
WEBPUSH_URGENCY=normal

# Clé publique VAPID — visible côté frontend pour l'inscription des navigateurs.
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"

# Google OAuth (Social Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Recherche globale — Typesense (Phase 6)
# Lancer en dev : podman run -d -p 8108:8108 -v ./typesense-data:/data typesense/typesense:27 --data-dir /data --api-key=${TYPESENSE_API_KEY} --enable-cors
SCOUT_DRIVER=typesense
SCOUT_QUEUE=true
TYPESENSE_API_KEY=xyz
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# Paiement mobile money (Phase 9) — REMPLIR avec vos identifiants sandbox.
# Ne jamais committer de vraies valeurs : ce fichier n'est qu'un gabarit.
PAYMENT_DEFAULT_PROVIDER=mtn_momo

# MTN MoMo Collections (sandbox: https://sandbox.momodeveloper.mtn.com)
PAYMENT_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
PAYMENT_MOMO_SUBSCRIPTION_KEY=
PAYMENT_MOMO_API_USER=
PAYMENT_MOMO_API_KEY=
PAYMENT_MOMO_TARGET_ENV=sandbox
PAYMENT_MOMO_CALLBACK_URL=https://example.test/api/webhooks/payment/momo
PAYMENT_MOMO_CURRENCY=EUR

# Orange Money Web Payment (URLs propres à l'opérateur/pays)
PAYMENT_ORANGE_BASE_URL=https://api.orange.com
PAYMENT_ORANGE_TOKEN_URL=https://api.orange.com/oauth/v3/token
PAYMENT_ORANGE_CONSUMER_KEY=
PAYMENT_ORANGE_CONSUMER_SECRET=
PAYMENT_ORANGE_MERCHANT_KEY=
PAYMENT_ORANGE_RETURN_URL=https://example.test/subscription/plans?payment=return
PAYMENT_ORANGE_CANCEL_URL=https://example.test/subscription/plans?payment=cancel
PAYMENT_ORANGE_NOTIF_URL=https://example.test/api/webhooks/payment/orange
PAYMENT_ORANGE_CURRENCY=XAF
PAYMENT_ORANGE_LANG=fr
